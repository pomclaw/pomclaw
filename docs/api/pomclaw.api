syntax = "v1"

import "skill.api"
import "tools.api"
import "traces.api"
import "memory.api"
import "mcp.api"

info (
	title:   "Pomclaw API"
	desc:    "Pomclaw Multi-Tenant Agent Platform API"
	author:  "Pomclaw Team"
	email:   "support@pomclaw.com"
	version: "v1"
)

// ============ Auth Types ============
type RegisterReq {
	Email    string `json:"email"`
	Password string `json:"password"`
	Username string `json:"username"`
}

type LoginReq {
	Username string `json:"username"`
	Password string `json:"password"`
}

type AuthResp {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	UserId       string `json:"user_id"`
	Username     string `json:"username"`
	ExpiresIn    int64  `json:"expires_in"`
	TokenType    string `json:"token_type"`
}

type UserResp {
	Id        string `json:"id"`
	Email     string `json:"email"`
	Username  string `json:"username"`
	CreatedAt int64  `json:"created_at"`
}

type RefreshReq {
	RefreshToken string `json:"refresh_token"`
}

type LogoutReq {}

type LogoutResp {}

type GetMeReq {}

type GetMeResp {
	User UserResp `json:"user"`
}

// ============ Agent Types ============
type Agent {
	// Basic fields
	Id          string `json:"id"`
	DisplayName string `json:"display_name"`
	Frontmatter string `json:"frontmatter,omitempty"`
	OwnerId     string `json:"owner_id"`
	// LLM configuration
	ProviderID        int64  `json:"provider_id"`
	Model             string `json:"model"`
	ContextWindow     int    `json:"context_window"`
	MaxToolIterations int    `json:"max_tool_iterations"`
	// Workspace
	Workspace           string `json:"workspace"`
	RestrictToWorkspace bool   `json:"restrict_to_workspace"`
	// Type and status
	AgentType string `json:"agent_type"`
	IsDefault bool   `json:"is_default"`
	Status    string `json:"status"`
	// JSONB configs
	//    ToolsConfig []byte `json:"tools_config,omitempty"`
	//    MemoryConfig []byte `json:"memory_config,omitempty"`
	//    CompactionConfig []byte `json:"compaction_config,omitempty"`
	//    OtherConfig []byte `json:"other_config,omitempty"`
	// V3 fields
	Emoji            string `json:"emoji,omitempty"`
	AgentDescription string `json:"agent_description,omitempty"`
	ThinkingLevel    string `json:"thinking_level,omitempty"`
	MaxTokens        int    `json:"max_tokens,omitempty"`
	SelfEvolve       bool   `json:"self_evolve,omitempty"`
	SkillEvolve      bool   `json:"skill_evolve,omitempty"`
	IsShared         bool   `json:"is_shared"`
	CreatedBy        string `json:"created_by,omitempty"`
	CreatedByName    string `json:"created_by_name"`
	// Timestamps
	CreatedAt int64 `json:"created_at"`
	UpdatedAt int64 `json:"updated_at"`
}

type ListAgentsReq {}

type ListAgentsResp {
	Total  int64   `json:"total"`
	Agents []Agent `json:"agents"`
}

type CreateAgentReq {
	DisplayName      string `json:"display_name"`
	Frontmatter      string `json:"frontmatter,optional"`
	ProviderID       int64  `json:"provider_id"`
	Model            string `json:"model"`
	AgentDescription string `json:"agent_description,optional"`
	// Optional advanced fields
	ContextWindow     int    `json:"context_window,optional"`
	MaxToolIterations int    `json:"max_tool_iterations,optional"`
	Workspace         string `json:"workspace,optional"`
	//    ToolsConfig []byte `json:"tools_config,optional"`
	//    MemoryConfig []byte `json:"memory_config,optional"`
	//    CompactionConfig []byte `json:"compaction_config,optional"`
	//    OtherConfig []byte `json:"other_config,optional"`
	// V3 fields
	Emoji         string `json:"emoji,optional"`
	ThinkingLevel string `json:"thinking_level,optional"`
	MaxTokens     int    `json:"max_tokens,optional"`
	SelfEvolve    bool   `json:"self_evolve,optional"`
	SkillEvolve   bool   `json:"skill_evolve,optional"`
	IsShared      bool   `json:"is_shared,optional"`
}

type CreateAgentResp {
	Agent Agent `json:"agent"`
}

type GetAgentReq {
	AgentId string `path:"agent_id"`
}

type GetAgentResp {
	Agent Agent `json:"agent"`
}

type UpdateAgentReq {
	AgentId string `path:"agent_id"`
	// All fields are optional for partial updates
	DisplayName       string `json:"display_name,optional"`
	Frontmatter       string `json:"frontmatter,optional"`
	ProviderID        int64  `json:"provider_id,optional"`
	Model             string `json:"model,optional"`
	Status            string `json:"status,optional"`
	ContextWindow     int    `json:"context_window,optional"`
	MaxToolIterations int    `json:"max_tool_iterations,optional"`
	Workspace         string `json:"workspace,optional"`
	//    ToolsConfig []byte `json:"tools_config,optional"`
	//    MemoryConfig []byte `json:"memory_config,optional"`
	//    CompactionConfig []byte `json:"compaction_config,optional"`
	//    OtherConfig []byte `json:"other_config,optional"`
	AgentDescription string `json:"agent_description,optional"`
	Emoji            string `json:"emoji,optional"`
	ThinkingLevel    string `json:"thinking_level,optional"`
	MaxTokens        int    `json:"max_tokens,optional"`
	SelfEvolve       bool   `json:"self_evolve,optional"`
	SkillEvolve      bool   `json:"skill_evolve,optional"`
	IsShared         bool   `json:"is_shared,optional"`
}

type UpdateAgentResp {
	Agent Agent `json:"agent"`
}

type DeleteAgentReq {
	AgentId string `path:"agent_id"`
}

type DeleteAgentResp {}

// ============ Agent File Types ============
type BootstrapFile {
	Name    string `json:"name"` // filename (e.g. "SOUL.md")
	Missing bool   `json:"missing"` // true if file doesn't exist
	Size    int    `json:"size,omitempty"` // file size in bytes
	Content string `json:"content,omitempty"` // file content (only in get/set responses)
}

type ListAgentFilesReq {
	AgentId string `path:"agent_id"`
}

type ListAgentFilesResp {
	AgentId string          `json:"agent_id"`
	Files   []BootstrapFile `json:"files"`
}

type GetAgentFileReq {
	AgentId string `path:"agent_id"`
	Name    string `path:"name"`
}

type GetAgentFileResp {
	AgentId string        `json:"agent_id"`
	File    BootstrapFile `json:"file"`
}

type SetAgentFileReq {
	AgentId   string `path:"agent_id"`
	Name      string `path:"name"`
	Content   string `json:"content"`
	Propagate bool   `json:"propagate,optional"` // push change to all existing user instances
}

type SetAgentFileResp {
	AgentId    string        `json:"agent_id"`
	File       BootstrapFile `json:"file"`
	Propagated int           `json:"propagated"` // number of instances where file was propagated
}

// ============ System Prompt Preview Types ============
type PromptSection {
	Name  string `json:"name"` // section name from markdown header
	Start int    `json:"start"` // character position start
	End   int    `json:"end"` // character position end
}

type ToolDefinition {
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
}

type GetSystemPromptPreviewReq {
	AgentId string `path:"agent_id"`
	Mode    string `form:"mode,optional,default=full"` // full|task|minimal|none
	UserId  string `form:"user_id,optional"`
}

type GetSystemPromptPreviewResp {
	Mode       string           `json:"mode"`
	Prompt     string           `json:"prompt"`
	TokenCount int              `json:"token_count"`
	Sections   []PromptSection  `json:"sections"`
	Tools      []ToolDefinition `json:"tools,omitempty"`
}

// ============ Session Types ============
type Session {
	Id           int64  `json:"id"`
	AgentId      string `json:"agent_id"`
	Title        string `json:"title"`
	Preview      string `json:"preview"`
	MessageCount int    `json:"message_count"`
	Created      string `json:"created"`
	Updated      string `json:"updated"`
}

type ListSessionsReq {
	Offset int `form:"offset,optional,default=0"`
	Limit  int `form:"limit,optional,default=20"`
}

type ListSessionsResp {
	Total    int64     `json:"total"`
	Sessions []Session `json:"sessions"`
}

type CreateSessionReq {
	AgentId string `json:"agent_id"`
}

type CreateSessionResp {
	Session Session `json:"session"`
}

type GetSessionReq {
	Id int64 `path:"id"`
}

type GetSessionResp {
	Session Session `json:"session"`
}

type DeleteSessionReq {
	Id int64 `path:"id"`
}

type DeleteSessionResp {}

// ============ Provider Types ============
type Provider {
	Id            int64  `json:"id"`
	Name          string `json:"name"`
	Description   string `json:"description,omitempty"`
	ProviderType  string `json:"provider_type"`
	APIBase       string `json:"api_base"`
	APIKey        string `json:"api_key"`
	Enabled       bool   `json:"enabled"`
	IsShared      bool   `json:"is_shared"`
	CreatedBy     string `json:"created_by,omitempty"`
	CreatedByName string `json:"created_by_name"`
}

type ListProvidersReq {}

type ListProvidersResp {
	Total     int64      `json:"total"`
	Providers []Provider `json:"providers"`
}

type CreateProviderReq {
	Name         string `json:"name"`
	Description  string `json:"description,optional"`
	ProviderType string `json:"provider_type"`
	APIBase      string `json:"api_base"`
	APIKey       string `json:"api_key"`
	Enabled      bool   `json:"enabled"`
}

type CreateProviderResp {
	Provider Provider `json:"provider"`
}

type UpdateProviderReq {
	Id          int64  `path:"id"`
	Name        string `json:"name,omitempty"`
	Description string `json:"description,optional"`
	APIBase     string `json:"api_base,omitempty"`
	APIKey      string `json:"api_key,omitempty"`
	Enabled     bool   `json:"enabled,omitempty"`
}

type GetProviderReq {
	Id int64 `path:"id"`
}

type GetProviderResp {
	Provider Provider `json:"provider"`
}

type UpdateProviderResp {
	Provider Provider `json:"provider"`
}

type DeleteProviderReq {
	Id int64 `path:"id"`
}

type DeleteProviderResp {}

type ListProviderModelsReq {
	Id int64 `path:"id"`
}

type ListProviderModelsResp {
	Models []string `json:"models"`
}

type VerifyProviderReq {
	Id    int64  `path:"id"`
	Model string `json:"model"`
}

type VerifyProviderResp {
	Valid bool   `json:"valid"`
	Error string `json:"error,omitempty"`
	Note  string `json:"note,omitempty"`
}

// ============ Usage Analytics Types ============
type UsageTimeSeriesPoint {
	BucketTime    string  `json:"bucket_time"`
	RequestCount  int     `json:"request_count"`
	ErrorCount    int     `json:"error_count"`
	UniqueUsers   int     `json:"unique_users"`
	InputTokens   int64   `json:"input_tokens"`
	OutputTokens  int64   `json:"output_tokens"`
	TotalCost     float64 `json:"total_cost"`
	LLMCallCount  int     `json:"llm_call_count"`
	ToolCallCount int     `json:"tool_call_count"`
	AvgDurationMS int     `json:"avg_duration_ms"`
}

type GetUsageTimeSeriesReq {
	From     string `form:"from"`
	To       string `form:"to"`
	GroupBy  string `form:"group_by,optional,default=hour"`
	AgentID  string `form:"agent_id,optional"`
	Channel  string `form:"channel,optional"`
	Provider string `form:"provider,optional"`
	Model    string `form:"model,optional"`
}

type GetUsageTimeSeriesResp {
	Points []UsageTimeSeriesPoint `json:"points"`
}

type UsageSummary {
	Requests      int     `json:"requests"`
	InputTokens   int64   `json:"input_tokens"`
	OutputTokens  int64   `json:"output_tokens"`
	Cost          float64 `json:"cost"`
	UniqueUsers   int     `json:"unique_users"`
	Errors        int     `json:"errors"`
	LLMCalls      int     `json:"llm_calls"`
	ToolCalls     int     `json:"tool_calls"`
	AvgDurationMS int     `json:"avg_duration_ms"`
}

type GetUsageSummaryReq {
	Period   string `form:"period,optional,default=24h"`
	AgentID  string `form:"agent_id,optional"`
	Channel  string `form:"channel,optional"`
	Provider string `form:"provider,optional"`
	Model    string `form:"model,optional"`
}

type GetUsageSummaryResp {
	Current  UsageSummary `json:"current"`
	Previous UsageSummary `json:"previous"`
}

// ============ System Health Types ============
type QuotaUsage {
	RequestsToday     int64 `json:"requests_today"`
	InputTokensToday  int64 `json:"input_tokens_today"`
	OutputTokensToday int64 `json:"output_tokens_today"`
	CostToday         int64 `json:"cost_today"`
}

type SystemHealth {
	Version         string `json:"version"`
	Uptime          int64  `json:"uptime"`
	Agents          int    `json:"agents"`
	Tools           int    `json:"tools"`
	Sessions        int    `json:"sessions"`
	Providers       int    `json:"providers"`
	Skills          int    `json:"skills"`
	Memory          int    `json:"memory"`
	Document        int    `json:"document"`
	ChannelTotal    int    `json:"channelTotal"`
	ChannelOnline   int    `json:"channelOnline"`
	ChannelDegraded int    `json:"channelDegraded"`
	ChannelFailed   int    `json:"channelFailed"`
}

type GetSystemHealthReq {}

type GetSystemHealthResp {
	Health     SystemHealth `json:"health"`
	QuotaUsage QuotaUsage   `json:"quota_usage"`
}

// ============ Agent Authorization Types ============
type AgentAuthorizationSkill {
	Id            int64  `json:"id"`
	Name          string `json:"name"`
	Slug          string `json:"slug"`
	Description   string `json:"description"`
	Version       int    `json:"version"`
	Visibility    string `json:"visibility"`
	IsSystem      bool   `json:"is_system"`
	CreatedBy     string `json:"created_by,omitempty"`
	CreatedByName string `json:"created_by_name,omitempty"`
}

type AgentAuthorizationMCP {
	ServerID   string `json:"server_id"`
	ServerName string `json:"server_name"`
	Transport  string `json:"transport"`
	Enabled    bool   `json:"enabled"`
}

type AgentAuthorizationToolPolicy {
	Profile        string   `json:"profile,omitempty"`
	Allow          []string `json:"allow,omitempty"`
	Deny           []string `json:"deny,omitempty"`
	AlsoAllow      []string `json:"alsoAllow,omitempty"`
	ToolCallPrefix string   `json:"toolCallPrefix,omitempty"`
}

type GetAgentAuthorizationsReq {
	AgentId string `path:"agent_id"`
}

type GetAgentAuthorizationsResp {
	Skills     []AgentAuthorizationSkill     `json:"skills"`
	MCPServers []AgentAuthorizationMCP       `json:"mcp_servers"`
	ToolPolicy *AgentAuthorizationToolPolicy `json:"tool_policy,omitempty"`
}

@server (
	prefix: /pomclaw-api
	jwt:    Auth
)
service pomclaw {
	// // ============ Auth Endpoints ============
	// @doc "User registration"
	// @handler Register
	// post /v1/auth/register (RegisterReq) returns (AuthResp)
	//
	// @doc "User login"
	// @handler Login
	// post /v1/auth/login (LoginReq) returns (AuthResp)
	//
	// @doc "Get current user info"
	// @handler GetMe
	// get /v1/auth/me (GetMeReq) returns (GetMeResp)
	//
	// @doc "Refresh authentication token"
	// @handler Refresh
	// post /v1/auth/refresh (RefreshReq) returns (AuthResp)
	//
	// @doc "User logout"
	// @handler Logout
	// post /v1/auth/logout (LogoutReq) returns (LogoutResp)
	// ============ Agent Endpoints ============
	@doc "List all agents"
	@handler ListAgents
	get /v1/agents (ListAgentsReq) returns (ListAgentsResp)

	@doc "Create a new agent"
	@handler CreateAgent
	post /v1/agents (CreateAgentReq) returns (CreateAgentResp)

	@doc "Get agent details"
	@handler GetAgent
	get /v1/agents/:agent_id (GetAgentReq) returns (GetAgentResp)

	@doc "Update agent"
	@handler UpdateAgent
	put /v1/agents/:agent_id (UpdateAgentReq) returns (UpdateAgentResp)

	@doc "Delete agent"
	@handler DeleteAgent
	delete /v1/agents/:agent_id (DeleteAgentReq) returns (DeleteAgentResp)

	// ============ Agent File Endpoints ============
	@doc "List agent bootstrap files (SOUL.md, AGENTS.md, etc.)"
	@handler ListAgentFiles
	get /v1/agents/:agent_id/files (ListAgentFilesReq) returns (ListAgentFilesResp)

	@doc "Get specific agent bootstrap file content"
	@handler GetAgentFile
	get /v1/agents/:agent_id/files/:name (GetAgentFileReq) returns (GetAgentFileResp)

	@doc "Set agent bootstrap file content"
	@handler SetAgentFile
	put /v1/agents/:agent_id/files/:name (SetAgentFileReq) returns (SetAgentFileResp)

	@doc "Get system prompt preview for agent"
	@handler GetSystemPromptPreview
	get /v1/agents/:agent_id/system-prompt-preview (GetSystemPromptPreviewReq) returns (GetSystemPromptPreviewResp)

	// ============ Session Endpoints ============
	@doc "List all sessions"
	@handler ListSessions
	get /v1/sessions (ListSessionsReq) returns (ListSessionsResp)

	@doc "Create a new session"
	@handler CreateSession
	post /v1/sessions (CreateSessionReq) returns (CreateSessionResp)

	@doc "Get session details"
	@handler GetSession
	get /v1/sessions/:id (GetSessionReq) returns (GetSessionResp)

	@doc "Delete session"
	@handler DeleteSession
	delete /v1/sessions/:id (DeleteSessionReq) returns (DeleteSessionResp)

	// ============ Provider Endpoints ============
	@doc "List all providers"
	@handler ListProviders
	get /v1/providers (ListProvidersReq) returns (ListProvidersResp)

	@doc "Create a new provider"
	@handler CreateProvider
	post /v1/providers (CreateProviderReq) returns (CreateProviderResp)

	@doc "Get provider details"
	@handler GetProvider
	get /v1/providers/:id (GetProviderReq) returns (GetProviderResp)

	@doc "Update provider"
	@handler UpdateProvider
	put /v1/providers/:id (UpdateProviderReq) returns (UpdateProviderResp)

	@doc "Delete provider"
	@handler DeleteProvider
	delete /v1/providers/:id (DeleteProviderReq) returns (DeleteProviderResp)

	@doc "List provider models"
	@handler ListProviderModels
	get /v1/providers/:id/models (ListProviderModelsReq) returns (ListProviderModelsResp)

	@doc "Verify provider"
	@handler VerifyProvider
	post /v1/providers/:id/verify (VerifyProviderReq) returns (VerifyProviderResp)

	// ============ Usage Analytics Endpoints ============
	@doc "Get usage time series"
	@handler GetUsageTimeSeries
	get /v1/usage/timeseries (GetUsageTimeSeriesReq) returns (GetUsageTimeSeriesResp)

	@doc "Get usage summary"
	@handler GetUsageSummary
	get /v1/usage/summary (GetUsageSummaryReq) returns (GetUsageSummaryResp)

	// ============ System Health Endpoints ============
	@doc "Get system health status"
	@handler GetSystemHealth
	get /v1/system/health (GetSystemHealthReq) returns (GetSystemHealthResp)

	//service skills
	@doc "List all skills"
	@handler ListSkills
	get /v1/skills (ListSkillsReq) returns (SkillsResp)

	@doc "Get skill details"
	@handler GetSkill
	get /v1/skills/:id (GetSkillReq) returns (GetSkillResp)

	@doc "Update skill"
	@handler UpdateSkill
	put /v1/skills/:id (UpdateSkillReq) returns (UpdateSkillResp)

	@doc "Upload skill zip package"
	@handler UploadSkill
	post /v1/skills/upload (UploadSkillReq) returns (UploadSkillResp)

	@doc "List skills for agent with grant status"
	@handler ListAgentSkills
	get /v1/agents/:agent_id/skills (ListAgentSkillsReq) returns (SkillsWithGrantResp)

	// ============ Skill Grant Endpoints ============
	@doc "List all agent grants for a skill"
	@handler ListSkillGrants
	get /v1/skills/:id/grants (ListSkillGrantsReq) returns (ListSkillGrantsResp)

	@doc "Grant skill to agent"
	@handler GrantSkillAgent
	post /v1/skills/:id/grants/agent (GrantSkillAgentReq) returns (GrantSkillAgentResp)

	@doc "Revoke skill grant from agent"
	@handler RevokeSkillAgentGrant
	delete /v1/skills/:id/grants/agent/:agent_id (RevokeSkillAgentGrantReq) returns (RevokeSkillAgentGrantResp)

	//service tools
	@doc "List all built-in tools"
	@handler ListBuiltinTools
	get /v1/tools/builtin (ListBuiltinToolsReq) returns (ListBuiltinToolsResp)

	@doc "Get built-in tool details"
	@handler GetBuiltinTool
	get /v1/tools/builtin/:name (GetBuiltinToolReq) returns (GetBuiltinToolResp)

	@doc "Update built-in tool (enabled, settings)"
	@handler UpdateBuiltinTool
	put /v1/tools/builtin/:name (UpdateBuiltinToolReq) returns (UpdateBuiltinToolResp)

	// ============ Trace Endpoints ============
	@doc "List traces with optional filtering"
	@handler ListTraces
	get /v1/traces (ListTracesReq) returns (ListTracesResp)

	@doc "Get trace details with spans"
	@handler GetTrace
	get /v1/traces/:traceID (GetTraceReq) returns (GetTraceResp)

	@doc "Export trace as gzip-compressed JSON"
	@handler ExportTrace
	get /v1/traces/:traceID/export (ExportTraceReq) returns (ExportTraceResp)

	@doc "Get cost summary by date, agent, model, or provider"
	@handler GetCostSummary
	get /v1/costs/summary (GetCostSummaryReq) returns (GetCostSummaryResp)

	// ============ Memory API Routes ============
	@doc "List all memory documents (global)"
	@handler ListMemoryDocuments
	get /v1/memory/documents (ListMemoryDocumentsReq) returns (ListMemoryDocumentsResp)

	@doc "List memory documents for specific agent"
	@handler GetAgentMemoryDocuments
	get /v1/agents/:agentID/memory/documents (ListAgentMemoryDocumentsReq) returns (ListMemoryDocumentsResp)

	@doc "Get specific memory document by path"
	@handler GetMemoryDocument
	get /v1/agents/:agentID/memory/documents/:documentID (GetMemoryDocumentReq) returns (GetMemoryDocumentResp)

	@doc "Create or update memory document"
	@handler PutMemoryDocument
	put /v1/agents/:agentID/memory/documents/:documentID (PutMemoryDocumentReq) returns (PutMemoryDocumentResp)

	@doc "Delete memory document"
	@handler DeleteMemoryDocument
	delete /v1/agents/:agentID/memory/documents/:documentID (DeleteMemoryDocumentReq) returns (DeleteMemoryDocumentResp)

	@doc "List memory chunks for agent"
	@handler ListMemoryChunks
	get /v1/agents/:agentID/memory/chunks (ListMemoryChunksReq) returns (ListMemoryChunksResp)

	@doc "Index single document"
	@handler IndexDocument
	post /v1/agents/:agentID/memory/index (IndexDocumentReq) returns (IndexDocumentResp)

	@doc "Index all documents"
	@handler IndexAll
	post /v1/agents/:agentID/memory/index-all (IndexAllReq) returns (IndexAllResp)

	@doc "Search memory documents"
	@handler SearchMemory
	post /v1/agents/:agentID/memory/search (SearchMemoryReq) returns (SearchMemoryResp)

	// ============ MCP Server Endpoints ============
	@doc "List all MCP servers"
	@handler ListMCPServers
	get /v1/mcp/servers (ListMCPServersReq) returns (ListMCPServersResp)

	@doc "Create a new MCP server"
	@handler CreateMCPServer
	post /v1/mcp/servers (CreateMCPServerReq) returns (CreateMCPServerResp)

	@doc "Test MCP server connection without saving"
	@handler TestMCPServerConnection
	post /v1/mcp/servers/test (TestMCPServerConnectionReq) returns (TestMCPServerConnectionResp)

	@doc "Get MCP server details"
	@handler GetMCPServer
	get /v1/mcp/servers/:id (GetMCPServerReq) returns (GetMCPServerResp)

	@doc "Update MCP server"
	@handler UpdateMCPServer
	put /v1/mcp/servers/:id (UpdateMCPServerReq) returns (UpdateMCPServerResp)

	@doc "Delete MCP server"
	@handler DeleteMCPServer
	delete /v1/mcp/servers/:id (DeleteMCPServerReq) returns (DeleteMCPServerResp)

	@doc "Reconnect MCP server (evict connection pool)"
	@handler ReconnectMCPServer
	post /v1/mcp/servers/:id/reconnect (ReconnectMCPServerReq) returns (ReconnectMCPServerResp)

	@doc "List tools for an MCP server"
	@handler ListMCPServerTools
	get /v1/mcp/servers/:id/tools (ListMCPServerToolsReq) returns (ListMCPServerToolsResp)

	// ============ MCP Grant Endpoints ============
	@doc "List all agent grants for an MCP server"
	@handler ListMCPServerGrants
	get /v1/mcp/servers/:id/grants (ListMCPServerGrantsReq) returns (ListMCPServerGrantsResp)

	@doc "Grant MCP server access to an agent"
	@handler GrantMCPServerAgent
	post /v1/mcp/servers/:id/grants/agent (GrantMCPServerAgentReq) returns (GrantMCPServerAgentResp)

	@doc "Revoke MCP server access from an agent"
	@handler RevokeMCPServerAgentGrant
	delete /v1/mcp/servers/:id/grants/agent/:agent_id (RevokeMCPServerAgentGrantReq) returns (RevokeMCPServerAgentGrantResp)

	@doc "List all MCP servers granted to an agent"
	@handler ListAgentMCPServers
	get /v1/mcp/grants/agent/:agent_id (ListAgentMCPServersReq) returns (ListAgentMCPServersResp)

	@doc "Get agent authorizations (granted skills, MCP servers, tool policy)"
	@handler GetAgentAuthorizations
	get /v1/agents/:agent_id/authorizations (GetAgentAuthorizationsReq) returns (GetAgentAuthorizationsResp)
}

