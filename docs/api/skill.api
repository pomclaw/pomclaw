syntax = "v1"

info(
    title: "Skill API"
    desc: "Skill management API for pomclaw"
    version: "1.0.0"
)

// ListSkillsReq - List skills request
type ListSkillsReq {
}

// GetSkillReq - Get skill request
type GetSkillReq {
    ID int64 `path:"id"`
}

// GetSkillResp - Get skill response
type GetSkillResp {
    Skill SkillResp `json:"skill"`
    Content string `json:"content"`
}

// GrantSkillAgentReq - Grant skill to agent
type GrantSkillAgentReq {
    ID int64 `path:"id"`
    AgentID string `json:"agent_id"`
}

// GrantSkillAgentResp - Grant skill to agent response
type GrantSkillAgentResp {
    Grant SkillAgentGrant `json:"grant"`
}

// RevokeSkillAgentGrantReq - Revoke skill grant from agent
type RevokeSkillAgentGrantReq {
    ID int64 `path:"id"`
    AgentID string `path:"agent_id"`
}

// RevokeSkillAgentGrantResp - Revoke skill grant from agent response
type RevokeSkillAgentGrantResp {
}

// ListSkillGrantsReq - List skill grants request
type ListSkillGrantsReq {
    ID int64 `path:"id"`
}

// ListSkillGrantsResp - List skill grants response
type ListSkillGrantsResp {
    AgentGrants []SkillAgentGrant `json:"agent_grants"`
}

// SkillAgentGrant - Skill grant for an agent
type SkillAgentGrant {
    ID string `json:"id"`
    SkillID int64 `json:"skill_id"`
    AgentID string `json:"agent_id"`
    AgentName string `json:"agent_name,omitempty"`
    Enabled bool `json:"enabled"`
    GrantedBy string `json:"granted_by,omitempty"`
    CreatedAt int64 `json:"created_at"`
}

// UpdateSkillReq - Update skill request
type UpdateSkillReq {
    ID int64 `path:"id"`
    Enabled bool `json:"enabled,optional"`
    Name string `json:"name,optional"`
    Description string `json:"description,optional"`
    Status string `json:"status,optional"`
    IsShared bool `json:"is_shared,optional"`
}

// UpdateSkillResp - Update skill response
type UpdateSkillResp {
    Skill SkillResp `json:"skill"`
}

// SkillResp - Skill response
type SkillResp {
    ID int64 `json:"id"`
    Name string `json:"name"`
    Slug string `json:"slug"`
    Description string `json:"description"`
    Enabled bool `json:"enabled"`
    Status string `json:"status"`
    Version int `json:"version"`
    IsSystem bool `json:"is_system"`
    Source string `json:"source"`
    Visibility string `json:"visibility"`
    Tags []string `json:"tags"`
    MissingDeps []string `json:"missing_deps"`
    ContentUrl string `json:"content_url,omitempty"`
    IsShared bool `json:"is_shared"`
    CreatedBy string `json:"created_by,omitempty"`
    CreatedByName string `json:"created_by_name"`
    AgentCount int `json:"agent_count,omitempty"`
}

// SkillWithGrantResp - Skill with grant status
type SkillWithGrantResp {
    ID int64 `json:"id"`
    Name string `json:"name"`
    Slug string `json:"slug"`
    Description string `json:"description"`
    Enabled bool `json:"enabled"`
    Status string `json:"status"`
    Version int `json:"version"`
    IsSystem bool `json:"is_system"`
    Source string `json:"source"`
    Visibility string `json:"visibility"`
    Tags []string `json:"tags"`
    MissingDeps []string `json:"missing_deps"`
    Granted bool `json:"granted"`
    IsShared bool `json:"is_shared"`
    CreatedBy string `json:"created_by,omitempty"`
    CreatedByName string `json:"created_by_name"`
    AgentCount int `json:"agent_count,omitempty"`
}

// SkillsResp - List skills response
type SkillsResp {
    Skills []SkillResp `json:"skills"`
}

// SkillsWithGrantResp - List skills with grant status response
type SkillsWithGrantResp {
    Skills []SkillWithGrantResp `json:"skills"`
}

// ToggleSkillGrantResp - Toggle skill grant response
type ToggleSkillGrantResp {
    Enabled bool `json:"enabled"`
}

// ListAgentSkillsReq - List agent skills request
type ListAgentSkillsReq {
    AgentID string `path:"agent_id"`
}

// UploadSkillReq - Upload skill request (multipart form, file handled manually)
type UploadSkillReq {
}

// UploadSkillResp - Upload skill response
type UploadSkillResp {
    ID         int64  `json:"id"`
    Slug       string `json:"slug"`
    Version    int    `json:"version"`
    Name       string `json:"name"`
    Status     string `json:"status"`
    IsNew      bool   `json:"is_new"`
    ContentUrl string `json:"content_url"`
}


