# Backend Configuration
VITE_BACKEND_PORT=18790
VITE_BACKEND_HOST=localhost

# ============================================================================
# API Prefix Configuration (CRITICAL - Configure per environment)
# ============================================================================
# This prefix is prepended to ALL HTTP and WebSocket API calls.
# Examples:
#   VITE_API_PREFIX=/pomclaw      → requests go to GET /pomclaw/v1/agents
#   VITE_API_PREFIX=/api/v2       → requests go to GET /api/v2/v1/agents
#   VITE_API_PREFIX=               → requests go to GET /v1/agents (no prefix)
#
# Leave EMPTY for no prefix (default in dev with Vite proxy)
# Set to /pomclaw for production when backend serves at /pomclaw prefix
VITE_API_PREFIX=

# ============================================================================
# WebSocket URL (Optional - uses VITE_API_PREFIX if not set)
# ============================================================================
# When set, this overrides the auto-constructed URL from VITE_API_PREFIX
# Only needed if you want a different WS URL than the constructed one
# Examples:
#   ws://localhost:18790/pomclaw/ws
#   wss://api.example.com/pomclaw/ws
# Leave empty or comment out to use auto-constructed URL from VITE_API_PREFIX
VITE_WS_URL=ws://localhost:18790/ws
